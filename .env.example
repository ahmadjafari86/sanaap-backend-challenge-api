DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TRUST_PROXY=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False

POSTGRES_DB=sanaap
POSTGRES_USER=sanaap
POSTGRES_PASSWORD=local-db-password
DATABASE_URL=postgresql://sanaap:local-db-password@127.0.0.1:15432/sanaap

REDIS_URL=redis://127.0.0.1:16379/0
CELERY_BROKER_URL=redis://127.0.0.1:16379/1
CHANNEL_REDIS_URL=redis://127.0.0.1:16379/2
WEBSOCKET_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DOCUMENT_STAGING_ROOT=.staging
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_PUBLICATION_ATTEMPTS=20
OUTBOX_UPLOAD_STALE_SECONDS=300
OUTBOX_RECOVERY_INTERVAL_SECONDS=60

MINIO_ROOT_USER=sanaap-local
MINIO_ROOT_PASSWORD=local-minio-password
MINIO_ENDPOINT_URL=http://127.0.0.1:19000
MINIO_PUBLIC_ENDPOINT_URL=http://127.0.0.1:19000
MINIO_BUCKET_NAME=documents
